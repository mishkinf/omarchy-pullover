#!/usr/bin/env python3
"""Pullover - an unofficial Pushover Open Client for Omarchy.

Not released or supported by Pushover.

Pushover has no Linux app. What it has is the Open Client API: register this
machine as a device, hold a websocket to client.pushover.net, and every push
that would reach the phone or the Mac app arrives here too. This is the whole
client -- login, the socket, the desktop notification, and the state file the
Omarchy bar widget reads.

The websocket carries no message content. It carries single bytes that mean
"something changed"; the messages themselves come over HTTPS. So the socket
going quiet is indistinguishable from nothing happening, which is why there is
a watchdog rather than a trust in the connection staying up.
"""

from __future__ import annotations

import argparse
import asyncio
import getpass
import html
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

try:
    import requests
except ImportError:  # pragma: no cover - the setup script installs this
    sys.exit("pullover: python-requests is not installed (pacman -S python-requests)")

VERSION = "2.0.0"
USER_AGENT = f"omarchy-pullover/{VERSION} (Linux)"

API = "https://api.pushover.net/1"
WEBSOCKET_URL = "wss://client.pushover.net/push"
ICON_URL = "https://api.pushover.net/icons/{}.png"

# Exit codes systemd is told never to restart on: both mean a human has to act,
# and restarting would hammer the API with credentials that cannot work.
EXIT_REAUTH = 78       # the server rejected our credentials for good
EXIT_OTHER_SESSION = 79  # this device id logged in somewhere else

# The server sends '#' on its own schedule. Longer than any keepalive gap we
# have seen, short enough that a silently dead socket is noticed within minutes.
SILENCE_TIMEOUT = 120.0
RECONNECT_MIN = 5.0
RECONNECT_MAX = 300.0
HTTP_TIMEOUT = 30.0
# Icons are cosmetic and fetched inline, so they get a far shorter leash than
# the calls that carry actual messages.
ICON_TIMEOUT = 5.0
MAX_CACHED_ICONS = 200
MESSAGE_HISTORY = 50

# Pushover's own trial length. There is no API for licence or trial status --
# no endpoint, no field, no websocket frame -- so this is counted from the
# moment this device registered and is an ESTIMATE, not a reading.
TRIAL_DAYS = 30
TRIAL_WARN_AT_DAYS = (0, 1, 7)


def trial_state() -> dict:
    """Days left on the desktop trial, derived from the registration date.

    Nothing warns a user when the trial ends -- the device simply stops
    receiving -- so an estimate that is a few hours out is worth far more than
    no estimate at all. `licensed` suppresses it entirely, because a user who
    has paid must not be nagged and the API will not tell us that they have."""
    if not CREDENTIALS_PATH.exists():
        return {"known": False}

    registered = None
    licensed = False
    try:
        with CREDENTIALS_PATH.open() as handle:
            creds = json.load(handle)
        registered = creds.get("registered_at")
        licensed = bool(creds.get("licensed"))
    except (OSError, ValueError):
        pass

    if not registered:
        # Logged in before this field existed. The credentials file is written
        # once, at registration, so its mtime is that moment.
        try:
            registered = int(CREDENTIALS_PATH.stat().st_mtime)
        except OSError:
            return {"known": False}

    elapsed_days = (time.time() - float(registered)) / 86400.0
    remaining = TRIAL_DAYS - elapsed_days
    return {
        "known": True,
        "licensed": licensed,
        "registeredAt": int(registered),
        "expiresAt": int(float(registered) + TRIAL_DAYS * 86400),
        "daysRemaining": int(math.ceil(remaining)) if remaining > 0 else 0,
    }


def suggested_device_name() -> str:
    """Pushover device names are unique per account and constrained to 25 chars
    of [A-Za-z0-9_-]. Two machines both defaulting to "omarchy" would collide on
    the second one's registration, so the hostname is the better default."""
    import socket

    raw = ""
    try:
        raw = socket.gethostname().split(".")[0]
    except OSError:
        pass
    cleaned = re.sub(r"[^A-Za-z0-9_-]", "-", raw).strip("-")[:25]
    return cleaned or "omarchy"


def config_dir() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or (Path.home() / ".config")
    return Path(base) / "pullover"


def state_dir() -> Path:
    base = os.environ.get("XDG_STATE_HOME") or (Path.home() / ".local" / "state")
    return Path(base) / "pullover"


def cache_dir() -> Path:
    base = os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")
    return Path(base) / "pullover" / "icons"


CREDENTIALS_PATH = config_dir() / "credentials.json"
STATUS_PATH = state_dir() / "status.json"
TRIAL_WARNED_PATH = state_dir() / "trial-warned.json"


def log(message: str) -> None:
    print(f"pullover: {message}", flush=True)


_REDACTIONS: list[str] = []


def register_secret(value: str) -> None:
    """Values that must never reach the state file or the journal."""
    if value and value not in _REDACTIONS:
        _REDACTIONS.append(value)


def redact(text: object) -> str:
    """The secret is a GET query parameter, so requests' own exception messages
    quote it back inside the URL -- and those messages were being written to
    status.json and printed to the journal. Neither is mode 600 when `run` is
    started by hand rather than by systemd."""
    out = str(text)
    for value in _REDACTIONS:
        out = out.replace(value, "[redacted]")
    return out


def coerce_int(value: object, fallback: int = 0) -> int:
    """Every number in a message is server-supplied and has been the wrong type
    in practice. int() on a string id raised ValueError, which nothing caught."""
    try:
        return int(value)
    except (TypeError, ValueError):
        return fallback


# --------------------------------------------------------------------------
# credentials


def load_credentials() -> dict:
    if not CREDENTIALS_PATH.exists():
        sys.exit(
            "pullover: not logged in.\n"
            "  Run: pullover login (or use the bar widget)"
        )
    try:
        with CREDENTIALS_PATH.open() as handle:
            creds = json.load(handle)
    except (OSError, ValueError) as error:
        # Unguarded, a truncated credentials file was a traceback every 5
        # seconds forever, and the helpful message below was unreachable.
        sys.exit(
            f"pullover: could not read {CREDENTIALS_PATH}: {error}\n"
            "  Sign in again: pullover login --force"
        )
    if not isinstance(creds, dict):
        sys.exit(f"pullover: {CREDENTIALS_PATH} is not valid credentials; sign in again")
    for field in ("secret", "device_id"):
        if not creds.get(field):
            sys.exit(f"pullover: credentials.json is missing '{field}'; run login again")
    return creds


def save_credentials(creds: dict) -> None:
    # The trial is dated from this file's mtime when registered_at is absent,
    # and every rewrite (licensed, login --force) moves that mtime. Stamping the
    # old mtime before the first rewrite freezes the real date; without it,
    # `licensed --undo` on a legacy install silently restarted the countdown.
    if not creds.get("registered_at"):
        try:
            creds = dict(creds, registered_at=int(CREDENTIALS_PATH.stat().st_mtime))
        except OSError:
            pass
    CREDENTIALS_PATH.parent.mkdir(parents=True, exist_ok=True)
    # Written through a 0600 temp file so the secret is never briefly readable.
    tmp = CREDENTIALS_PATH.with_suffix(".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as handle:
        json.dump(creds, handle, indent=2)
    os.replace(tmp, CREDENTIALS_PATH)


def api_post(path: str, data: dict) -> requests.Response:
    return requests.post(
        f"{API}/{path}",
        data=data,
        headers={"User-Agent": USER_AGENT},
        timeout=HTTP_TIMEOUT,
    )


def api_get(path: str, params: dict) -> requests.Response:
    return requests.get(
        f"{API}/{path}",
        params=params,
        headers={"User-Agent": USER_AGENT},
        timeout=HTTP_TIMEOUT,
    )


SERVICE = "pullover.service"


def perform_login(email: str, password: str, twofa: str, device_name: str, force: bool) -> dict:
    """The whole login, as data in and data out.

    Both front ends go through here -- the terminal prompts and the bar
    widget's form -- so neither can drift into a different login."""
    if CREDENTIALS_PATH.exists() and not force:
        return {"ok": False, "error": "Already logged in. Sign out first to replace it."}

    # Pushover's own constraint, checked here so the failure is readable
    # rather than a 400 from the API.
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,25}", device_name or ""):
        return {"ok": False, "error": "Device name must be 1-25 letters, digits, _ or -"}
    if not email or not password:
        return {"ok": False, "error": "Email and password are both required"}

    payload = {"email": email, "password": password}
    if twofa:
        payload["twofa"] = twofa

    try:
        response = api_post("users/login.json", payload)
    except requests.RequestException as error:
        return {"ok": False, "error": f"Could not reach Pushover: {error}"}

    # 412 is "this account has two-factor on". It is not a failure, it is a
    # request for one more field, so it gets its own flag rather than an error.
    if response.status_code == 412:
        return {"ok": False, "needsTwofa": True, "error": "Two-factor code required"}
    # The docs say 401 for a bad login; the API actually answers 403 (measured
    # 2026-09-22 against a wrong password). Both are the same thing to a user.
    if response.status_code in (401, 403):
        return {"ok": False, "error": "Pushover rejected that email and password"}
    if not response.ok:
        return {"ok": False, "error": f"Login failed (HTTP {response.status_code})"}

    try:
        secret = response.json().get("secret")
    except ValueError:
        # A captive portal answering 200 with HTML is exactly this.
        return {"ok": False, "error": "Pushover returned something unreadable"}
    if not secret:
        return {"ok": False, "error": "Login succeeded but returned no secret"}

    try:
        response = api_post("devices.json", {"secret": secret, "name": device_name, "os": "O"})
    except requests.RequestException as error:
        return {"ok": False, "error": f"Could not register the device: {error}"}

    if response.status_code == 400:
        # A name already in use and the 10-device account limit both land here,
        # and the API's own wording is more specific than anything we'd invent.
        detail = ""
        try:
            errors = response.json().get("errors") or []
            detail = "; ".join(str(e) for e in errors)
        except ValueError:
            pass
        return {"ok": False, "error": detail or f"Device '{device_name}' was rejected"}
    if not response.ok:
        return {"ok": False, "error": f"Device registration failed (HTTP {response.status_code})"}

    try:
        device_id = response.json().get("id")
    except ValueError:
        return {"ok": False, "error": "Pushover returned something unreadable"}
    if not device_id:
        return {"ok": False, "error": "Device registration returned no id"}

    save_credentials({
        "secret": secret,
        "device_id": device_id,
        "device_name": device_name,
        # The trial starts now, and nothing else will ever tell us when it did.
        "registered_at": int(time.time()),
    })
    return {"ok": True, "deviceName": device_name}


def systemctl(verb: str) -> tuple[bool, str]:
    try:
        result = subprocess.run(
            ["systemctl", "--user", verb, SERVICE],
            capture_output=True, text=True, timeout=20,
        )
        return result.returncode == 0, (result.stdout + result.stderr).strip()
    except (OSError, subprocess.SubprocessError) as error:
        return False, str(error)


def service_state() -> dict:
    active, active_out = systemctl("is-active")
    enabled, enabled_out = systemctl("is-enabled")
    # is-active exits non-zero for an inactive unit, so the word is the answer
    # and the exit code is not.
    return {
        "active": active_out == "active",
        "enabled": enabled_out in ("enabled", "enabled-runtime"),
    }


def cmd_login(args: argparse.Namespace) -> int:
    if args.stdin:
        # The password arrives over stdin, never argv: anything in argv is
        # readable by every process on the machine.
        #
        # One LINE, not read-to-EOF. A caller that writes the request but does
        # not close the pipe would hang here forever, and the bar widget is
        # exactly such a caller.
        try:
            request = json.loads(sys.stdin.readline() or "{}")
        except ValueError as error:
            print(json.dumps({"ok": False, "error": f"Could not read the request: {error}"}))
            return 1
        result = perform_login(
            str(request.get("email") or "").strip(),
            str(request.get("password") or ""),
            str(request.get("twofa") or "").strip(),
            str(request.get("deviceName") or args.device_name or suggested_device_name()),
            bool(request.get("force") or args.force),
        )
        print(json.dumps(result))
        return 0 if result.get("ok") else 1

    device_name = args.device_name or suggested_device_name()
    email = args.email or input("Pushover email: ").strip()
    password = getpass.getpass("Pushover password: ")
    result = perform_login(email, password, "", device_name, args.force)

    if result.get("needsTwofa"):
        twofa = input("Two-factor code: ").strip()
        result = perform_login(email, password, twofa, device_name, args.force)

    if not result.get("ok"):
        sys.exit(f"pullover: {result.get('error')}")

    print(f"\nRegistered this machine with Pushover as '{result['deviceName']}'.")
    print(f"Credentials: {CREDENTIALS_PATH} (mode 600)")
    print("\nPushover for Desktop is free for 30 days; after that it is a one-time $4.99")
    print("licence on your account: https://pushover.net/clients/desktop")
    print(f"\nStart receiving:  systemctl --user enable --now {SERVICE}")
    return 0


def cmd_probe(args: argparse.Namespace) -> int:
    """What the bar widget asks before deciding which screen to show."""
    logged_in = CREDENTIALS_PATH.exists()
    device_name = ""
    if logged_in:
        try:
            with CREDENTIALS_PATH.open() as handle:
                device_name = str(json.load(handle).get("device_name") or "")
        except (OSError, ValueError):
            # A credentials file we cannot read is not a login.
            logged_in = False
    print(json.dumps({
        "loggedIn": logged_in,
        "deviceName": device_name,
        "suggestedDeviceName": suggested_device_name(),
        "service": service_state(),
        "trial": trial_state(),
        "version": VERSION,
    }))
    return 0


def cmd_service(args: argparse.Namespace) -> int:
    verbs = {"enable": ["enable", "restart"], "restart": ["restart"], "stop": ["stop"]}[args.verb]
    for verb in verbs:
        ok, output = systemctl(verb)
        if not ok:
            print(json.dumps({"ok": False, "error": output or f"systemctl {verb} failed"}))
            return 1
    print(json.dumps({"ok": True, "service": service_state()}))
    return 0


def cmd_licensed(args: argparse.Namespace) -> int:
    """Record that the desktop licence has been bought, so the trial countdown
    stops. Pushover exposes no way to check this, so the user's word is the
    only source there is."""
    if not CREDENTIALS_PATH.exists():
        print(json.dumps({"ok": False, "error": "Not signed in"}))
        return 1
    with CREDENTIALS_PATH.open() as handle:
        creds = json.load(handle)
    creds["licensed"] = not args.undo
    save_credentials(creds)
    print(json.dumps({"ok": True, "trial": trial_state()}))
    return 0


def cmd_logout(args: argparse.Namespace) -> int:
    """Forgets the credentials on THIS machine. It cannot deregister the device:
    the Open Client API documents no endpoint for removing one, so the device
    stays on the account, keeps one of its ten slots, and must be retired by
    hand at https://pushover.net/devices ."""
    systemctl("disable")
    systemctl("stop")
    for path in (CREDENTIALS_PATH, STATUS_PATH, TRIAL_WARNED_PATH):
        try:
            path.unlink(missing_ok=True)
        except OSError:
            pass
    print(json.dumps({
        "ok": True,
        "note": "Credentials removed from this machine. The device is still "
                "registered on your Pushover account; retire it at "
                "https://pushover.net/devices",
    }))
    return 0


# --------------------------------------------------------------------------
# notifications


def strip_html(text: str) -> str:
    """Pushover's html=1 bodies carry a small tag subset."""
    return html.unescape(re.sub(r"<[^>]+>", "", text))


def escape_markup(text: str) -> str:
    """Omarchy renders a notification body as Qt StyledText, so a plain-text
    body containing < or & is read as markup and mangled. Pushover bodies are
    user-written and regularly contain both."""
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def body_for_notification(message: dict) -> str:
    """Pushover's html=1 subset -- b, i, u, font color, a href -- is exactly
    what Qt StyledText renders, and Omarchy strips only <img> before rendering.
    So an HTML body is passed through and a plain one is escaped. Stripping the
    tags instead, as this used to, threw away formatting the shell supports."""
    raw = str(message.get("message") or "")
    return raw if message.get("html") else escape_markup(raw)


def icon_path(icon_name: str) -> str | None:
    """Fetch and cache the sending app's icon. A missing icon is cosmetic, so
    every failure here returns None rather than raising."""
    name = re.sub(r"[^A-Za-z0-9_-]", "", icon_name or "pushover") or "pushover"
    target = cache_dir() / f"{name}.png"
    if target.exists():
        return str(target)
    try:
        response = requests.get(
            ICON_URL.format(name),
            headers={"User-Agent": USER_AGENT},
            timeout=ICON_TIMEOUT,
        )
        if not response.ok or not response.content:
            return None
        target.parent.mkdir(parents=True, exist_ok=True)
        tmp = target.with_suffix(".tmp")
        tmp.write_bytes(response.content)
        os.replace(tmp, target)
        return str(target)
    except (requests.RequestException, OSError):
        # OSError matters as much as a network failure here: a full disk or a
        # read-only cache used to raise straight out of notify(), out of
        # sync_messages, and be reported as "connection lost".
        return None


def urgency_for(priority: int) -> str:
    if priority <= -1:
        return "low"
    if priority >= 1:
        return "critical"
    return "normal"


def bypasses_dnd(priority: int) -> bool:
    """Pushover priority 1 is defined as bypassing the user's quiet hours, and
    2 is an emergency. Omarchy grants that only to the app names 'omarchy-action'
    and 'notify-send' (NotificationLogic.js shouldBypassDnd), so a push sent
    under its own app name is silenced by Do Not Disturb whatever its urgency."""
    return priority >= 1


def option_safe(text: str) -> str:
    """Keep an attacker-chosen positional out of option position.

    omarchy-notification-send takes the headline as $1 AFTER its option loop,
    so a title that is exactly a recognized flag is consumed as one: a title of
    "--urgency" makes the sender exit 1 and display nothing, and
    "--app-name=EvilCorp" spoofs the sender. A word joiner is invisible in the
    toast and cannot begin an option. The description slot deliberately allows
    a leading dash ("-50% off" is content), so this is applied to both only
    because the same string can land in either slot."""
    return "\u2060" + text if text.startswith("-") else text


def url_is_openable(url: str) -> bool:
    """The click action is handed to xdg-open, which will dispatch any scheme
    registered on the machine. A push is attacker-influenced, so only the two
    schemes a Pushover url is meant to carry are honoured."""
    return url.startswith("https://") or url.startswith("http://")


def notification_argv(message: dict, icon: str | None, native: bool) -> list[str]:
    app = str(message.get("app") or "Pushover")
    title = str(message.get("title") or app)
    body = body_for_notification(message)
    priority = coerce_int(message.get("priority"))
    url = str(message.get("url") or "")

    if not native:
        # Plain libnotify: no click action, and the app name always wins over
        # the DND bypass because notify-send cannot set Omarchy's hints.
        argv = ["notify-send", "--urgency", urgency_for(priority)]
        # Omarchy grants notify-send the DND bypass only at critical urgency and
        # only under that exact app name, so a high-priority push keeps the
        # bypass here the same way it does on the native path: by giving up the
        # app label rather than the delivery.
        if bypasses_dnd(priority):
            if app.lower() not in title.lower():
                title = f"{app}: {title}"
        else:
            argv += ["--app-name", app]
        if priority >= 2:
            argv += ["--expire-time", "0"]
        if icon:
            argv += ["--icon", icon]
        if url:
            body = f"{body}\n{escape_markup(str(message.get('url_title') or url))}".strip()
        return argv + ["--", title, body]

    argv = ["omarchy-notification-send", "--urgency", urgency_for(priority)]

    if bypasses_dnd(priority):
        # Left as the default app name 'omarchy-action', which is what earns the
        # bypass. The sender is named in the headline instead, so nothing is lost
        # but the little grey app label.
        if app.lower() not in title.lower():
            title = f"{app}: {title}"
    else:
        argv += ["--app-name", app]

    if priority >= 2:
        argv += ["--expire-time", "0"]
    if icon:
        argv += ["--icon", icon]

    argv += [option_safe(title), option_safe(body)]

    # A click opens the message's own URL. Omarchy carries this as data rather
    # than a libnotify action, so it still works on a toast restored after a
    # shell restart.
    if url and url_is_openable(url):
        argv += ["--exec", "xdg-open", url]
    return argv


def _run_sender(argv: list[str]) -> int:
    """Return the sender's exit code, or non-zero if it could not be run at all.
    which() is a check-then-use, so the binary can still be gone by now."""
    try:
        return subprocess.run(argv, check=False, timeout=15).returncode
    except subprocess.TimeoutExpired:
        log("the notification command timed out")
    except OSError as error:
        log(f"could not run the notification command: {redact(error)}")
    return 1


def notify(message: dict) -> bool:
    """True when a notification was displayed. The caller deletes the message
    from Pushover after this, so a silent failure here loses it."""
    native = shutil.which("omarchy-notification-send") is not None
    have_fallback = shutil.which("notify-send") is not None
    if not native and not have_fallback:
        log("neither omarchy-notification-send nor notify-send is installed")
        return False

    icon = icon_path(str(message.get("icon") or "pushover"))

    if native:
        if _run_sender(notification_argv(message, icon, True)) == 0:
            return True
        log("the native sender failed; falling back to notify-send")
    if have_fallback:
        return _run_sender(notification_argv(message, icon, False)) == 0
    return False


# --------------------------------------------------------------------------
# state file the bar widget reads


class Status:
    def __init__(self) -> None:
        self.connected = False
        self.last_error = ""
        self.device_name = ""
        self.messages: list[dict] = []

    def load(self) -> None:
        """Adopt the history already on disk.

        Without this a restart -- a reboot, an update, a dropped socket that
        outlived its backoff -- writes an empty message list on connect and the
        panel forgets everything it was showing a second earlier."""
        try:
            data = json.loads(STATUS_PATH.read_text())
        except (OSError, ValueError):
            return
        if not isinstance(data, dict) or not isinstance(data.get("messages"), list):
            return
        kept = [m for m in data["messages"] if isinstance(m, dict)][:MESSAGE_HISTORY]
        for message in kept:
            # A file written before idStr existed. Python still holds the exact
            # integer here; the widget would have to round it.
            if not message.get("idStr"):
                message["idStr"] = str(message.get("id") or "")
        self.messages = kept

    def record(self, messages: list[dict]) -> None:
        for message in messages:
            self.messages.append({
                "id": coerce_int(message.get("id")),
                # Pushover ids are 19 digits, past JavaScript's safe-integer
                # range, so the widget compares these strings and never the
                # number -- JSON.parse would silently round the number.
                "idStr": str(message.get("id_str") or message.get("id") or ""),
                "title": str(message.get("title") or message.get("app") or "Pushover"),
                "message": strip_html(str(message.get("message") or ""))
                if message.get("html") else str(message.get("message") or ""),
                "app": str(message.get("app") or "Pushover"),
                "date": coerce_int(message.get("date")),
                "priority": coerce_int(message.get("priority")),
                "url": str(message.get("url") or ""),
                "urlTitle": str(message.get("url_title") or ""),
                "receipt": str(message.get("receipt") or ""),
                "acked": bool(message.get("acked")),
            })
        # Newest first, and only a window of them: this file is read by the bar
        # on every change, so it stays small on purpose.
        # Deduplicated by id: a failed update_highest_message re-delivers the
        # same batch, and without this the history fills with copies that evict
        # real messages out of the window and skew the widget's unread count.
        seen = set()
        unique = []
        for message in sorted(self.messages, key=lambda m: coerce_int(m.get("date")), reverse=True):
            key = message.get("idStr") or str(message.get("id"))
            if key in seen:
                continue
            seen.add(key)
            unique.append(message)
        self.messages = unique[:MESSAGE_HISTORY]

    def write(self) -> None:
        payload = {
            "schemaVersion": 1,
            "connected": self.connected,
            "lastError": self.last_error,
            "deviceName": self.device_name,
            "updatedAt": int(time.time()),
            "messages": self.messages,
        }
        # Atomic rename: the widget watches this path, and a half-written file
        # would read to it as a corrupt daemon rather than a slow one.
        #
        # Failures are swallowed on purpose. write() is called from inside the
        # reconnect handler, so an OSError raised here would escape every
        # `except` above it and end the process over a cosmetic file.
        try:
            STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
            tmp = STATUS_PATH.with_suffix(".tmp")
            tmp.write_text(json.dumps(payload, indent=2))
            os.replace(tmp, STATUS_PATH)
        except OSError as error:
            log(f"could not write the status file: {redact(error)}")

    def clear(self) -> None:
        # An absent file is how the widget knows the daemon is not running.
        try:
            STATUS_PATH.unlink(missing_ok=True)
        except OSError:
            pass


# --------------------------------------------------------------------------
# the client


class Client:
    def __init__(self, creds: dict) -> None:
        self.secret = creds["secret"]
        self.device_id = creds["device_id"]
        self._trial_checked_at: float | None = None
        # Set once a frame has actually arrived. A connection that completes the
        # handshake and dies immediately used to reset the backoff, so a
        # flapping server was retried every 5s forever and RECONNECT_MAX was
        # unreachable.
        self.proved = False
        self.status = Status()
        self.status.device_name = creds.get("device_name") or ""
        self.status.load()

    def maybe_warn_about_trial(self) -> None:
        """Warn before the trial ends rather than after.

        An unlicensed device just stops receiving -- no notice, no error the
        user sees -- so the one failure worth engineering against here is
        finding out by missing something."""
        # None, not 0.0: time.monotonic() is seconds since boot on Linux, so
        # `now - 0.0 < 3600` is true for the first hour of every uptime and the
        # check silently never ran -- including the one at connect time.
        now = time.monotonic()
        if self._trial_checked_at is not None and now - self._trial_checked_at < 3600:
            return
        self._trial_checked_at = now

        trial = trial_state()
        if not trial.get("known") or trial.get("licensed"):
            return

        try:
            warned = set(json.loads(TRIAL_WARNED_PATH.read_text()))
        except (OSError, ValueError):
            warned = set()

        remaining = coerce_int(trial.get("daysRemaining"))

        # Every threshold at or below the current remaining has been passed.
        # Burning all of them at once, rather than one per tick, is what stops a
        # late first start announcing "7 days" this hour and "1 day" the next --
        # and stops the nonsense line "trial ends in 0 days".
        crossed = {t for t in TRIAL_WARN_AT_DAYS if remaining <= t}
        if not crossed - warned:
            return

        if remaining <= 0:
            title = "Trial has ended"
            body = ("This device may stop receiving Pushover messages. A one-time "
                    "$4.99 desktop licence keeps it working.")
        else:
            title = f"Trial ends in {remaining} day{'s' if remaining != 1 else ''}"
            body = ("After that this device stops receiving Pushover messages. "
                    "A one-time $4.99 licence keeps it working.")

        notify({
            "title": title,
            "message": body,
            "app": "Pullover",
            "priority": 1,
            "url": "https://pushover.net/clients/desktop",
            "url_title": "Buy the licence",
        })

        warned |= crossed
        try:
            TRIAL_WARNED_PATH.parent.mkdir(parents=True, exist_ok=True)
            TRIAL_WARNED_PATH.write_text(json.dumps(sorted(warned)))
        except OSError:
            pass

    def sync_messages(self) -> None:
        """Never raises. A malformed field in a server payload used to escape
        run()'s three-exception handler, kill the process, and have systemd
        restart it into the same batch every 5 seconds forever -- re-notifying
        each time, because the delete had not been reached."""
        try:
            self._sync_messages()
        except Exception as error:  # noqa: BLE001 - see the docstring
            self.status.last_error = f"could not process messages: {redact(error)}"
            self.status.write()
            log(self.status.last_error)

    def _sync_messages(self) -> None:
        """Download everything queued, show it, then tell the server it landed.

        The delete is only sent after the notifications are out, so a crash
        mid-sync re-shows a push rather than losing it. A duplicate
        notification is a far cheaper failure than a missed one."""
        response = api_get("messages.json", {"secret": self.secret, "device_id": self.device_id})
        if not response.ok:
            self.status.last_error = f"could not fetch messages (HTTP {response.status_code})"
            self.status.write()
            log(self.status.last_error)
            return

        messages = response.json().get("messages") or []
        if not messages:
            return

        log(f"{len(messages)} new message(s)")
        undisplayed = 0
        for message in messages:
            if not notify(message):
                undisplayed += 1

        self.status.record(messages)
        if undisplayed:
            # The watermark below is all-or-nothing, so a message whose toast
            # failed cannot be left on the server without re-showing every
            # message beside it on the next sync. It is recorded above instead,
            # so it is still in the panel -- unseen, not lost.
            self.status.last_error = (
                f"{undisplayed} notification(s) could not be displayed; "
                "they are listed here instead."
            )
        self.status.write()

        ids = [coerce_int(m.get("id")) for m in messages]
        highest = max([i for i in ids if i > 0], default=0)
        if highest <= 0:
            log("no usable message id in this batch; not advancing the watermark")
            return
        response = api_post(
            f"devices/{self.device_id}/update_highest_message.json",
            {"secret": self.secret, "message": highest},
        )
        if not response.ok:
            # Not fatal: the same messages arrive again next sync, which shows
            # as duplicates rather than as silence.
            log(f"could not clear messages up to {highest} (HTTP {response.status_code})")

    async def run(self) -> int:
        from websockets.asyncio.client import connect
        from websockets.exceptions import WebSocketException

        backoff = RECONNECT_MIN
        while True:
            try:
                # ping_interval is off because the server has its own keepalive
                # ('#') and does not answer websocket pings; the library's
                # pings would time out a perfectly healthy connection.
                async with connect(WEBSOCKET_URL, ping_interval=None, user_agent_header=USER_AGENT) as socket:
                    await socket.send(f"login:{self.device_id}:{self.secret}\n")
                    self.status.connected = True
                    self.status.last_error = ""
                    self.status.write()
                    log("connected")
                    self.proved = False

                    # Anything that arrived while we were disconnected is
                    # waiting on the server, and the socket will not announce it.
                    # Off the event loop: a backlog of messages is a blocking
                    # HTTPS call plus a subprocess per message, and nothing
                    # would service the socket or the watchdog meanwhile.
                    await asyncio.to_thread(self.sync_messages)
                    self.maybe_warn_about_trial()

                    verdict = await self.listen(socket)
                    if self.proved:
                        backoff = RECONNECT_MIN
                    if verdict is not None:
                        return verdict

            except (WebSocketException, OSError, requests.RequestException) as error:
                self.status.connected = False
                self.status.last_error = str(error) or error.__class__.__name__
                self.status.write()
                log(f"connection lost: {self.status.last_error}")

            await asyncio.sleep(backoff)
            backoff = min(backoff * 2, RECONNECT_MAX)

    async def listen(self, socket) -> int | None:
        """Return None to reconnect, or an exit code to stop for good."""
        while True:
            try:
                frame = await asyncio.wait_for(socket.recv(), timeout=SILENCE_TIMEOUT)
            except asyncio.TimeoutError:
                log(f"no keepalive for {SILENCE_TIMEOUT:.0f}s; reconnecting")
                return None

            if isinstance(frame, bytes):
                frame = frame.decode("utf-8", "replace")

            # Every byte, not just the first. The protocol is documented as one
            # byte per frame, but that is a claim about the server: a frame of
            # "#!" read as a bare keepalive would have dropped the push until
            # the next event or the 120s watchdog, silently.
            codes = set(frame)
            self.proved = True

            if "E" in codes or "A" in codes:
                code = "E" if "E" in codes else "A"
            elif "R" in codes:
                code = "R"
            elif "!" in codes:
                code = "!"
            elif "#" in codes:
                code = "#"
            else:
                code = frame[:1]

            if code == "#":
                # The keepalive is the only regular tick this process gets.
                self.maybe_warn_about_trial()
                continue
            if code == "!":
                await asyncio.to_thread(self.sync_messages)
                continue
            if code == "R":
                log("server asked for a reconnect")
                return None
            if code == "E":
                self.status.connected = False
                # Pushover sends the same frame for a rejected device and for
                # an unlicensed one past its trial, and exposes no way to tell
                # them apart, so neither is asserted as the cause.
                self.status.last_error = (
                    "Pushover disconnected this device. Either the desktop licence "
                    "has lapsed, or the device needs to sign in again."
                )
                self.status.write()
                log(self.status.last_error)
                notify({
                    "title": "Pushover disconnected",
                    "message": self.status.last_error,
                    "app": "Pushover",
                    "priority": 1,
                    "url": "https://pushover.net/clients/desktop",
                    "url_title": "Check your licence",
                })
                return EXIT_REAUTH
            if code == "A":
                self.status.connected = False
                self.status.last_error = "This device logged in from somewhere else."
                self.status.write()
                log(self.status.last_error)
                return EXIT_OTHER_SESSION

            log(f"unknown frame {frame!r}; reconnecting")
            return None


def cmd_run(args: argparse.Namespace) -> int:
    creds = load_credentials()
    register_secret(creds["secret"])
    client = Client(creds)

    # systemd stops this with SIGTERM, whose default action skips `finally`
    # entirely -- so status.json survived every normal stop still saying
    # "connected": true, and the widget believed it indefinitely.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))

    code = 1
    try:
        code = asyncio.run(client.run())
        return code
    except (KeyboardInterrupt, SystemExit):
        code = 0
        return 0
    finally:
        # A terminal exit carries the only explanation the user will get, and
        # deleting the file here used to throw it away microseconds after it
        # was written. Everything else clears, because an absent file is how
        # the widget knows nothing is running.
        if code in (EXIT_REAUTH, EXIT_OTHER_SESSION):
            client.status.connected = False
            client.status.write()
        else:
            client.status.clear()


def cmd_ack(args: argparse.Namespace) -> int:
    creds = load_credentials()
    response = api_post(f"receipts/{args.receipt}/acknowledge.json", {"secret": creds["secret"]})
    if not response.ok:
        sys.exit(f"pullover: acknowledge failed (HTTP {response.status_code}): {response.text[:200]}")
    print("acknowledged")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    if not STATUS_PATH.exists():
        print("pullover: not running (no status file)")
        return 1
    print(STATUS_PATH.read_text())
    return 0


def cmd_selftest(args: argparse.Namespace) -> int:
    """Prove the notification path works without waiting for a real push."""
    notify({
        "title": "Pushover",
        "message": "Notifications are wired up. This one is local, not from the server.",
        "app": "Pushover",
        "priority": 0,
        "icon": "pushover",
    })
    print("sent a local test notification")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="pullover", description=__doc__)
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="command", required=True)

    login = sub.add_parser("login", help="register this machine as a Pushover device")
    login.add_argument("--email", help="skip the email prompt")
    login.add_argument("--device-name", default=None,
                       help="device name shown in Pushover (default: this machine's hostname)")
    login.add_argument("--force", action="store_true", help="replace existing credentials")
    login.add_argument("--stdin", action="store_true",
                       help="read {email, password, twofa} as JSON on stdin and answer with JSON")
    login.set_defaults(func=cmd_login)

    probe = sub.add_parser("probe", help="JSON: whether this machine is logged in and running")
    probe.set_defaults(func=cmd_probe)

    service = sub.add_parser("service", help="enable, restart or stop the background client")
    service.add_argument("verb", choices=["enable", "restart", "stop"])
    service.set_defaults(func=cmd_service)

    licensed = sub.add_parser("licensed", help="record that the desktop licence is bought; stops the countdown")
    licensed.add_argument("--undo", action="store_true", help="unset it again")
    licensed.set_defaults(func=cmd_licensed)

    logout = sub.add_parser("logout", help="stop the client and forget the credentials")
    logout.set_defaults(func=cmd_logout)

    run = sub.add_parser("run", help="hold the websocket and show notifications")
    run.set_defaults(func=cmd_run)

    ack = sub.add_parser("ack", help="acknowledge an emergency-priority push")
    ack.add_argument("receipt")
    ack.set_defaults(func=cmd_ack)

    status = sub.add_parser("status", help="print the state file the bar widget reads")
    status.set_defaults(func=cmd_status)

    selftest = sub.add_parser("selftest", help="show a local test notification")
    selftest.set_defaults(func=cmd_selftest)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
