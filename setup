#!/bin/bash
# omarchy plugin add only clones files, so this is the rest of the install.

set -euo pipefail

root=$(cd "$(dirname "$0")" && pwd)

omarchy pkg add python-websockets python-requests libnotify

install -Dm755 "$root/bin/pushover-open-client" "$HOME/.local/bin/pushover-open-client"
install -Dm644 "$root/systemd/pushover-open-client.service" \
  "$HOME/.config/systemd/user/pushover-open-client.service"
systemctl --user daemon-reload

credentials="${XDG_CONFIG_HOME:-$HOME/.config}/pushover/credentials.json"

if [[ -f $credentials ]]; then
  # restart, not enable --now: an already-running daemon would otherwise stay
  # on the old script after an update.
  systemctl --user enable pushover-open-client.service
  systemctl --user restart pushover-open-client.service
  echo "Pushover client restarted."
else
  cat <<'MSG'

Installed. One step left — register this machine with Pushover:

  pushover-open-client login

Then start it:

  systemctl --user enable --now pushover-open-client.service

Pushover for Desktop is free for 30 days, then a one-time $4.99 licence on your
account: https://pushover.net/clients/desktop
MSG
fi

echo
echo "Add the bar widget:  omarchy bar add io.github.mishkinf.pushover --section right"
